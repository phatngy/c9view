{
  "name": "@c9view/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=development src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@c9view/api": "workspace:*",
    "@c9view/core": "workspace:*",
    "@c9view/node": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "description": "Browser-facing c9view hub: login, Host and Origin checks, the web build and the relay to nodes.",
  "license": "MIT"
}
